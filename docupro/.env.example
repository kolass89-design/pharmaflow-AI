# DOCUPRO configuration
# Copy to .env and adjust. Never commit a real .env file.
# Every value below is optional; the defaults shown are what the service uses
# when the variable is absent.

# --- storage ---------------------------------------------------------------
# Directory for per-job working folders. Must be writable by the container user.
DOCUPRO_DATA_DIR=/data
# Directory containing the built web client (index.html + assets/).
# Leave empty to run the API only.
DOCUPRO_WEB_DIR=/app/web

# --- upload policy ---------------------------------------------------------
# Per-file limit in megabytes.
DOCUPRO_MAX_UPLOAD_MB=50
# Total size of one job's inputs in megabytes.
DOCUPRO_MAX_JOB_MB=200
# Maximum number of files in one job (merge, image batches, ...).
DOCUPRO_MAX_FILES=20
# Maximum pages accepted in a PDF input.
DOCUPRO_MAX_PAGES=500
# Maximum decoded pixels per image (decompression-bomb protection).
DOCUPRO_MAX_PIXELS=80000000
# Office (OOXML) hardening: number of zip entries and total uncompressed MB.
DOCUPRO_MAX_OOXML_ENTRIES=5000
DOCUPRO_MAX_OOXML_MB=300

# --- retention -------------------------------------------------------------
# Minutes an output stays downloadable, then it is deleted by the sweeper.
DOCUPRO_RETENTION_MINUTES=30
# Seconds after the first complete download before the output is deleted
# (0 disables early deletion and keeps the normal retention window).
DOCUPRO_DELETE_AFTER_DOWNLOAD_SECONDS=120
# Sweeper interval in seconds.
DOCUPRO_SWEEP_SECONDS=30
# Hard cap on the number of job records kept in memory.
DOCUPRO_MAX_RETAINED_JOBS=200

# --- execution -------------------------------------------------------------
# Wall-clock limit per conversion in seconds.
DOCUPRO_CONVERSION_TIMEOUT=240
# Conversions executed in parallel by this process.
DOCUPRO_MAX_CONCURRENCY=2
# Jobs allowed to wait in the queue.
DOCUPRO_MAX_QUEUE=40

# --- abuse protection ------------------------------------------------------
# Requests per minute per client address (job creation and downloads).
DOCUPRO_RATE_LIMIT=40
DOCUPRO_RATE_BURST=20
# Trust X-Forwarded-For from a reverse proxy in front of the service.
DOCUPRO_TRUST_PROXY=1

# --- HTTP ------------------------------------------------------------------
# Comma-separated extra origins allowed to call the API (the web client is
# same-origin, so this is only needed for a split deployment).
DOCUPRO_CORS_ORIGINS=
DOCUPRO_LOG_LEVEL=INFO
# Serve interactive API docs at /api/docs (disabled by default).
DOCUPRO_ENABLE_DOCS=0
